# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0 OR MIT

ARG RUST_VERSION=1.97.0
FROM rust:${RUST_VERSION}-bookworm AS builder

WORKDIR /src
RUN apt-get update \
    && apt-get install --yes --no-install-recommends clang cmake libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY apps ./apps
COPY vendor ./vendor

RUN cargo build \
    --package stellaris-cli \
    --bin stellaris \
    --release \
    --locked \
    --no-default-features \
    --features backend-quinn

FROM debian:bookworm-slim AS runtime

ARG VERSION=dev
LABEL org.opencontainers.image.title="Stellaris agent" \
      org.opencontainers.image.description="TUN overlay agent for Stellaris" \
      org.opencontainers.image.source="https://github.com/kwsc98/Stellaris" \
      org.opencontainers.image.licenses="Apache-2.0 OR MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates iproute2 \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /etc/stellaris /var/lib/stellaris \
    && chmod 0700 /var/lib/stellaris

COPY --from=builder /src/target/release/stellaris /usr/local/bin/stellaris

ENV RUST_LOG=info
STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/stellaris"]
CMD ["agent", "run", "--config", "/etc/stellaris/agent.toml"]
