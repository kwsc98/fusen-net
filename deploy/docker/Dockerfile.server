# syntax=docker/dockerfile:1.7
# SPDX-License-Identifier: Apache-2.0 OR MIT

ARG RUST_VERSION=1.97.0
FROM rust:${RUST_VERSION}-bookworm AS builder

WORKDIR /src
RUN apt-get update \
    && apt-get install --yes --no-install-recommends clang cmake libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates ./crates
COPY apps ./apps
COPY vendor ./vendor

RUN cargo build \
    --package stellaris-cli \
    --bin stellaris \
    --release \
    --locked \
    --no-default-features \
    --features backend-quinn

FROM debian:bookworm-slim AS runtime

ARG VERSION=dev
LABEL org.opencontainers.image.title="Stellaris server" \
      org.opencontainers.image.description="Coordination service and trusted Relay for Stellaris" \
      org.opencontainers.image.source="https://github.com/kwsc98/Stellaris" \
      org.opencontainers.image.licenses="Apache-2.0 OR MIT" \
      org.opencontainers.image.version="${VERSION}"

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 stellaris \
    && useradd --system --uid 10001 --gid stellaris --no-create-home --home-dir /nonexistent stellaris \
    && mkdir -p /etc/stellaris /var/lib/stellaris \
    && chown stellaris:stellaris /etc/stellaris /var/lib/stellaris \
    && chmod 0700 /var/lib/stellaris

COPY --from=builder /src/target/release/stellaris /usr/local/bin/stellaris

USER 10001:10001
EXPOSE 7000/udp 7001/udp 7002/udp
ENV RUST_LOG=info
STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/stellaris"]
CMD ["server", "run", "--config", "/etc/stellaris/server.toml"]
